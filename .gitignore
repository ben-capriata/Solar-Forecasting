# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Downloaded data. Not tracked: python fetch_data.py refetches it in about a minute.
*.parquet
# Local outputs of an earlier version of the pipeline.
data/processed/

# Plots are ignored by default, but the seven report figures are deliverables,
# so results/figures is exempted.
*.png
!results/figures/*.png

# Keep the results directory structure present in a fresh clone.
!results/figures/
!results/checkpoints/

# Test-year predictions written by run.py for plots.py; regenerated on every run.
results/predictions/

DECISIONS.md
